# Copie para .env.local e preencha com os dados do projeto Supabase "dev".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Necessário apenas para ativar a análise de portas/janelas no scanner.
# Configure como variável de ambiente no Vercel; nunca coloque a chave no navegador.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini
